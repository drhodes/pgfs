PGFS := ./scripts/pgfs.sh

.PHONY: help up down status run build check clippy fmt fmt-check init-db db-stop shell clean test test-faults test-integration ensure-db bench fsck docs spec-diff bump-patch bump-minor bump-major

help:
	@echo "pgfs — PostgreSQL-backed FUSE filesystem"
	@echo
	@echo "Lifecycle (via scripts/pgfs.sh):"
	@echo "  make up        bring up Postgres + build + mount, wait until live"
	@echo "  make down      unmount cleanly"
	@echo "  make status    show mount / daemon / Postgres state"
	@echo "  make run       run pgfs in the foreground (Ctrl+C quits cleanly)"
	@echo
	@echo "Development:"
	@echo "  make build     cargo build"
	@echo "  make check     cargo check"
	@echo "  make clippy    cargo clippy, every target and feature set, -D warnings"
	@echo "  make fmt       cargo fmt   (make fmt-check: verify only)"
	@echo "  make test      unit, storage and model-conformance tests (needs the local cluster)"
	@echo "  make test-faults  database fault-injection tests (--features fault-injection)"
	@echo "  make test-integration  FUSE integration suite, pgfs check after each test"
	@echo "  make bench     run the benchmark workloads (scripts/bench.sh)"
	@echo "  make fsck      pgfs check against the project-local database"
	@echo
	@echo "Specification (libspec):"
	@echo "  make spec-diff live spec vs HEAD (uv run libspec diff)"
	@echo "  make docs      regenerate docs/ from spec/ and docs/cli-options.md from the binary"
	@echo "  make bump-patch | bump-minor | bump-major   bump the version in pyproject.toml and Cargo.toml"
	@echo "  make init-db   create/start the project-local Postgres cluster"
	@echo "  make db-stop   stop the project-local Postgres cluster"
	@echo "  make shell     nix develop"
	@echo "  make clean     cargo clean"

check-nix:
	@if [ -z "$$PGFS_ROOT" ]; then \
		echo "Error: Nix environment is not active."; \
		if ! nix-instantiate --eval --expr '1' >/dev/null 2>&1; then \
			if ! groups | grep -q '\bnix-users\b'; then \
				echo "Reason: Your user is not in the 'nix-users' group."; \
				echo "Fix: Run 'sudo usermod -aG nix-users $$USER' and log out/in (or run 'exec sg nix-users bash')."; \
			else \
				echo "Reason: Cannot access Nix daemon socket (/nix/var/nix/daemon-socket/socket)."; \
				echo "Fix: Ensure your active login shell session has the 'nix-users' group applied (e.g. run 'exec sg nix-users bash')."; \
			fi; \
		else \
			echo "Fix: Please enter the Nix dev shell using 'nix develop' or 'make shell'."; \
		fi; \
		exit 1; \
	fi

up: check-nix
	$(PGFS) up

down:
	$(PGFS) down

status:
	$(PGFS) status

run: check-nix
	$(PGFS) run

build: check-nix
	cargo build

check: check-nix
	cargo check

clippy: check-nix
	cargo clippy --all-targets -- -D warnings
	cargo clippy --all-targets --features fault-injection -- -D warnings
	cargo clippy --all-targets --features profiling -- -D warnings

fmt: check-nix
	cargo fmt

fmt-check: check-nix
	cargo fmt --check

ensure-db: check-nix
	@./scripts/ensure_db.sh

test: check-nix ensure-db
	cargo test

test-faults: check-nix ensure-db
	cargo test --features fault-injection --test fault_injection

test-integration: check-nix
	./scripts/run_tests.sh

fsck: check-nix ensure-db
	cargo build --quiet
	PGFS_CONN="$${PGFS_CONN:-host=$(CURDIR)/testdata dbname=pgfs}" ./target/debug/pgfs check

spec-diff:
	uv run libspec diff

docs: check-nix
	uv run python scripts/build_docs.py
	cargo build --quiet
	{ printf '# pgfs command-line options\n\nGenerated by `pgfs options` from the argument parser (spec/ops.py DocumentsEveryOption). A test fails when this page and the binary disagree.\n\n'; ./target/debug/pgfs options; } > docs/cli-options.md

# Bump MAJOR.MINOR.PATCH in pyproject.toml and Cargo.toml together.
bump-patch bump-minor bump-major:
	@part=$(subst bump-,,$@); \
	old=$$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml | head -1); \
	new=$$(echo "$$old" | awk -F. -v p=$$part '{ if (p=="major") print $$1+1".0.0"; else if (p=="minor") print $$1"."$$2+1".0"; else print $$1"."$$2"."$$3+1 }'); \
	sed -i "0,/^version = \"$$old\"/s//version = \"$$new\"/" pyproject.toml Cargo.toml; \
	echo "version $$old -> $$new"

bench: check-nix
	./scripts/bench.sh

init-db: check-nix
	./scripts/init_db.sh

db-stop:
	pg_ctl -D testdata/pgdata stop

shell:
	nix --extra-experimental-features 'nix-command flakes' develop

clean:
	cargo clean

packout:
	packout spec/*.py src/*.rs sql/v1/*.sql tests/*.rs tests/*/*.rs flake.nix scripts/* design/chats/* Cargo.toml build.rs > /tmp/out
	git log >> /tmp/out
	xclip -selection clipboard < /tmp/out
